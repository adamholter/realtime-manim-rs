{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realtime-manim.local/schema/benchmark-result-v1.json",
  "title": "realtime-manim-rs benchmark receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "recorded_at_utc",
    "environment",
    "workload",
    "samples",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "recorded_at_utc": { "type": "string", "format": "date-time" },
    "environment": { "$ref": "#/$defs/environment" },
    "workload": { "$ref": "#/$defs/workload" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "os_version",
        "architecture",
        "processor",
        "memory_bytes",
        "display",
        "background_load_profile"
      ],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "os_version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "processor": { "type": "string", "minLength": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "display": {
          "anyOf": [
            { "$ref": "#/$defs/display" },
            { "type": "null" }
          ]
        },
        "background_load_profile": { "type": "string", "minLength": 1 }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "refresh_hz", "device_pixel_ratio_milli"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "refresh_hz": { "type": "integer", "minimum": 1 },
        "device_pixel_ratio_milli": { "type": "integer", "minimum": 1 }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scene", "resolution", "duration_seconds", "notes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scene": { "type": "string", "minLength": 1 },
        "resolution": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "statistic", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "statistic": { "type": "string", "minLength": 1 },
        "value": { "type": "number" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty", "commands", "artifacts"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
